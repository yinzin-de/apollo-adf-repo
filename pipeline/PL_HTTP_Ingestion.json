{
	"name": "PL_HTTP_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Read Claim Files",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "ds_httpconfigfile_csv",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Start time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "starttime",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_HH:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "ForEachClaimFile",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Read Claim Files",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Start time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Read Claim Files').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Audit-Start",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_audit_start]",
								"storedProcedureParameters": {
									"file_name": {
										"value": {
											"value": "@item().filename",
											"type": "Expression"
										},
										"type": "String"
									},
									"pipeline_name": {
										"value": {
											"value": "@pipeline().Pipeline",
											"type": "Expression"
										},
										"type": "String"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_AzureSqlDatabase",
								"type": "LinkedServiceReference",
								"parameters": {
									"db_name": {
										"value": "@item().auditdb",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "HTTP_to_Datalake",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Audit-Start",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_httpclaimfiles_csv",
									"type": "DatasetReference",
									"parameters": {
										"baseurl": {
											"value": "@item().baseurl",
											"type": "Expression"
										},
										"relativeurl": {
											"value": "@item().relativeurl",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_datalakeblobfiles_parquet",
									"type": "DatasetReference",
									"parameters": {
										"container": "bronze",
										"folder": {
											"value": "@concat(\n    item().source,\n    '/',item().filename,\n    '/',variables('starttime')\n)",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Update-logs",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "HTTP_to_Datalake",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[insert_load_log]",
								"storedProcedureParameters": {
									"data_source": {
										"value": {
											"value": "@item().source",
											"type": "Expression"
										},
										"type": "String"
									},
									"tablename": {
										"value": {
											"value": "@item().filename",
											"type": "Expression"
										},
										"type": "String"
									},
									"watermarkcolumnname": {
										"value": null,
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_AzureSqlDatabase",
								"type": "LinkedServiceReference",
								"parameters": {
									"db_name": {
										"value": "@item().auditdb",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Audit Success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "HTTP_to_Datalake",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_audit_success]",
								"storedProcedureParameters": {
									"file_name": {
										"value": {
											"value": "@item().filename",
											"type": "Expression"
										},
										"type": "String"
									},
									"rows_read": {
										"value": {
											"value": "@activity('HTTP_to_Datalake').output.rowsRead",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"rows_written": {
										"value": {
											"value": "@activity('HTTP_to_Datalake').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int64"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_AzureSqlDatabase",
								"type": "LinkedServiceReference",
								"parameters": {
									"db_name": {
										"value": "@item().auditdb",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "Fail Audit",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "HTTP_to_Datalake",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[usp_audit_failed]",
								"storedProcedureParameters": {
									"error_message": {
										"value": {
											"value": "@activity('HTTP_to_Datalake').error.message",
											"type": "Expression"
										},
										"type": "String"
									},
									"file_name": {
										"value": {
											"value": "@item().filename",
											"type": "Expression"
										},
										"type": "String"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "ls_AzureSqlDatabase",
								"type": "LinkedServiceReference",
								"parameters": {
									"db_name": {
										"value": "@item().auditdb",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"starttime": {
				"type": "String"
			}
		},
		"annotations": []
	}
}